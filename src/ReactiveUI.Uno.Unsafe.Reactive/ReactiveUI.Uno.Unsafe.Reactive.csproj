<Project Sdk="Uno.Sdk/7.0.22">
  <PropertyGroup>
    <TargetFrameworks>$(UnoTargetFrameworks)</TargetFrameworks>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Library</OutputType>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>ReactiveUI.Uno.Unsafe.Reactive</PackageId>
    <!-- Uno generates a GlobalStaticResources type in the root namespace, so this must differ from ReactiveUI.Uno.Reactive's. -->
    <RootNamespace>ReactiveUI.Uno.Unsafe.Reactive</RootNamespace>
    <DefineConstants>$(DefineConstants);REACTIVE_SHIM</DefineConstants>
    <PackageDescription>Reflection-based ReactiveUI.Uno.Reactive APIs that are not safe to trim or to compile ahead of time, such as WinRTAppDataDriverUnsafe.</PackageDescription>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Content>
      <Pack>false</Pack>
    </Content>
  </ItemDefinitionGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- The same source the lean package compiles, recompiled against System.Reactive. -->
  <ItemGroup>
    <Compile Include="..\ReactiveUI.Uno.Unsafe\**\*.cs"
             Exclude="..\ReactiveUI.Uno.Unsafe\bin\**;..\ReactiveUI.Uno.Unsafe\obj\**"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReactiveUI.Uno.Reactive\ReactiveUI.Uno.Reactive.csproj" />
    <PackageReference Include="ReactiveUI.Unsafe.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ReactiveUI.Reactive" />
    <Using Include="System.Reactive.Unit" Alias="Unit" />
    <Using Include="System.Reactive.Linq.Observable" Alias="Observable" />
  </ItemGroup>
</Project>
