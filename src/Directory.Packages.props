<Project>
  <!--
    To update the version of Uno, you should instead update the Sdk version in the global.json file.

    See https://aka.platform.uno/using-uno-sdk for more information.
    See https://aka.platform.uno/using-uno-sdk#implicit-packages for more information regarding the Implicit Packages.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- StyleSharp.Analyzers, PerformanceSharp.Analyzers and SecuritySharp.Analyzers ship from the
         same release pipeline and always share a version. -->
    <RoslynCommonAnalyzersVersion>3.41.7</RoslynCommonAnalyzersVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="ReactiveUI" Version="24.1.0" />
    <PackageVersion Include="ReactiveUI.Reactive" Version="24.1.0" />
    <PackageVersion Include="ReactiveUI.Primitives" Version="7.1.1" />
    <PackageVersion Include="ReactiveUI.Primitives.Reactive" Version="7.1.1" />
    <PackageVersion Include="ReactiveUI.Primitives.Blazor" Version="7.1.1" />
    <PackageVersion Include="ReactiveUI.Primitives.Blazor.Reactive" Version="7.1.1" />
    <PackageVersion Include="Splat" Version="21.0.0" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <PackageVersion Include="StyleSharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)" />
    <PackageVersion Include="PerformanceSharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)" />
    <PackageVersion Include="SecuritySharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <!-- Test projects only -->
  <ItemGroup>
    <PackageVersion Include="ReactiveUI.Testing" Version="24.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="bunit" Version="2.8.6" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.3.3" />
    <PackageVersion Include="TUnit" Version="1.64.6" />
    <PackageVersion Include="Verify.TUnit" Version="31.28.0" />
  </ItemGroup>
  <!-- Example projects only -->
  <ItemGroup>
    <PackageVersion Include="ReactiveUI.SourceGenerators" Version="3.2.0" />
    <PackageVersion Include="SQLite-net-pcl" Version="1.11.285" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>
</Project>
