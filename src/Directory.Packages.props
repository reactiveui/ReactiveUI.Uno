<Project>
  <!--
    To update Uno, update the version in each Uno project's Sdk declaration.

    See https://aka.platform.uno/using-uno-sdk for more information.
    See https://aka.platform.uno/using-uno-sdk#implicit-packages for more information regarding the Implicit Packages.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- StyleSharp.Analyzers, PerformanceSharp.Analyzers and SecuritySharp.Analyzers ship from the
         same release pipeline and always share a version. -->
    <RoslynCommonAnalyzersVersion>5.2.0</RoslynCommonAnalyzersVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="ReactiveUI" Version="28.0.0" />
    <PackageVersion Include="ReactiveUI.Reactive" Version="28.0.0" />
    <PackageVersion Include="ReactiveUI.Primitives" Version="10.2.3" />
    <PackageVersion Include="ReactiveUI.Primitives.Reactive" Version="10.2.3" />
    <PackageVersion Include="ReactiveUI.Primitives.Blazor" Version="10.2.3" />
    <PackageVersion Include="ReactiveUI.Primitives.Blazor.Reactive" Version="10.2.3" />
    <PackageVersion Include="ReactiveUI.Binding.Uno" Version="12.1.0" />
    <PackageVersion Include="ReactiveUI.Binding.Uno.Reactive" Version="12.1.0" />
    <PackageVersion Include="Splat" Version="22.0.1" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="StyleSharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)" />
    <PackageVersion Include="PerformanceSharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)" />
    <PackageVersion Include="SecuritySharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <!-- Test projects only -->
  <ItemGroup>
    <PackageVersion Include="ReactiveUI.Testing" Version="28.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.3" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
  </ItemGroup>
  <!-- Example projects only -->
  <ItemGroup>
    <PackageVersion Include="ReactiveUI.SourceGenerators" Version="7.1.0" />
    <PackageVersion Include="SQLite-net-pcl" Version="1.11.285" />
    <PackageVersion Include="CsvHelper" Version="34.1.0" />
  </ItemGroup>
</Project>
